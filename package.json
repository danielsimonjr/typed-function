{
  "name": "@danielsimonjr/typed-function",
  "version": "5.0.0-alpha.3",
  "description": "Type checking for JavaScript functions",
  "author": "Jos de Jong <wjosdejong@gmail.com> (https://github.com/josdejong)",
  "contributors": [
    "Glen Whitney (https://github.com/gwhitney)",
    "Luke Gumbley (https://github.com/luke-gumbley)",
    "Daniel Simon Jr (https://github.com/danielsimonjr)"
  ],
  "homepage": "https://github.com/danielsimonjr/typed-function",
  "repository": {
    "type": "git",
    "url": "https://github.com/danielsimonjr/typed-function.git"
  },
  "keywords": [
    "typed",
    "function",
    "arguments",
    "compose",
    "types",
    "typescript"
  ],
  "type": "module",
  "main": "./build/typed-function.cjs",
  "module": "./build/typed-function.mjs",
  "browser": "./build/typed-function.js",
  "types": "./build/index.d.ts",
  "exports": {
    ".": {
      "types": "./build/index.d.ts",
      "import": "./build/typed-function.mjs",
      "require": "./build/typed-function.cjs"
    },
    "./minimal": {
      "types": "./build/minimal.d.ts",
      "import": "./build/typed-function.minimal.mjs",
      "require": "./build/typed-function.minimal.cjs"
    },
    "./wasm": {
      "types": "./build/wasm/index.d.ts",
      "import": "./build/wasm/index.js",
      "require": "./build/wasm/index.js"
    },
    "./wasm/dispatch.wasm": "./build/dispatch.wasm",
    "./debug": {
      "types": "./build/debug.d.ts",
      "import": "./build/debug.js",
      "require": "./build/debug.js"
    }
  },
  "sideEffects": false,
  "scripts": {
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "build": "npm-run-all build:clean build:wasm build:ts",
    "build:clean": "del-cli build",
    "build:wasm": "asc --config assembly/asconfig.json --target release",
    "build:wasm:debug": "asc --config assembly/asconfig.json --target debug",
    "build:ts": "rollup -c rollup.config.js",
    "typecheck": "tsc --noEmit",
    "typecheck:wasm": "tsc -p assembly/tsconfig.json --noEmit",
    "lint": "eslint --cache src/**/*.ts test/**/*.ts",
    "format": "npm run lint -- --fix",
    "build-and-test": "npm run typecheck && npm run build && npm run test",
    "prepublishOnly": "npm run build-and-test"
  },
  "engines": {
    "node": ">= 18"
  },
  "devDependencies": {
    "@rollup/plugin-commonjs": "^29.0.0",
    "@rollup/plugin-node-resolve": "^16.0.3",
    "@rollup/plugin-terser": "^1.0.0",
    "@rollup/plugin-typescript": "^12.3.0",
    "@types/node": "^24.10.1",
    "@typescript-eslint/eslint-plugin": "^8.48.1",
    "@typescript-eslint/parser": "^8.48.1",
    "@vitest/coverage-v8": "^4.0.15",
    "assemblyscript": "^0.28.9",
    "del-cli": "6.0.0",
    "eslint": "8.57.1",
    "eslint-config-standard": "17.1.0",
    "eslint-plugin-import": "2.32.0",
    "eslint-plugin-n": "16.6.2",
    "eslint-plugin-promise": "6.6.0",
    "npm-run-all": "4.1.5",
    "rollup": "^4.60.2",
    "tslib": "^2.8.1",
    "typescript": "^5.9.3",
    "vitest": "^4.0.15"
  },
  "files": [
    "README.md",
    "LICENSE.md",
    "build",
    "src"
  ],
  "license": "MIT",
  "overrides": {
    "serialize-javascript": "^7.0.5"
  }
}
